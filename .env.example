# GitHub webhook ingress configuration.
#
# Copy to .env (git-ignored) and fill in the real values. The start script reads
# it, and the environment it is started with wins over these.

# The secret configured on the GitHub webhook. The service refuses to start
# without it.
WEBHOOK_SECRET=

# Where the service listens.
HOST=127.0.0.1
PORT=8000

# One of DEBUG, INFO, WARNING, ERROR. INFO writes one record per delivery.
LOG_LEVEL=INFO

# Used by scripts/forward.sh only.
GITHUB_REPO=szerming/github-app-template
WEBHOOK_EVENTS=*
